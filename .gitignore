# Machine-specific compose mounts — keep per-machine, use the .example as a template
docker-compose.override.yml

# Secrets / local env
.env
deploy/.env

# Built image tars (56MB+; rebuild instead of committing)
deploy/*.tar.gz

# Python
__pycache__/
*.pyc

# OS noise
.DS_Store
.claude/settings.local.json
deploy/*.bundle

# Local database bind-mount (never commit DB files)
/pgdata/

# Database dumps — never commit (contain user password hashes)
*.sql

# Built/exported image bundles (exceed GitHub's 100MB limit — rebuild instead)
dist/

# ELN app and scratch worktrees live in the separate Ereztech-ELN repo,
# not in this scheduler repo.
/eln/
/transfer/
/.worktrees/
